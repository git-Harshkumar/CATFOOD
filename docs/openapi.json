{
  "openapi": "3.0.3",
  "info": {
    "title": "DOGFOOD 2026 Hackathon Judgment Platform API",
    "description": "Production-ready REST API for hackathon submission, multi-criterion judging, cross-judge z-score normalization, Bradley-Terry pairwise voting, community engagement, webhooks, and cryptographically verifiable certificates.",
    "version": "1.0.0",
    "contact": {
      "name": "DOGFOOD 2026 Platform Team",
      "email": "organizer@hack.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local / Docker compose deployment"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "description": "Returns service status and current timestamp.",
        "responses": {
          "200": {
            "description": "API is operational"
          }
        }
      }
    },
    "/projects": {
      "get": {
        "summary": "Public project gallery",
        "description": "Returns list of submitted projects for public browsing.",
        "responses": {
          "200": {
            "description": "Project gallery list"
          }
        }
      }
    },
    "/projects/new": {
      "post": {
        "summary": "Submit a project",
        "description": "Creates a project submission. Strictly rejected with 403 once event deadline passes.",
        "responses": {
          "201": {
            "description": "Project submitted successfully"
          },
          "403": {
            "description": "Submission deadline has passed"
          }
        }
      }
    },
    "/api/judge/scores": {
      "get": {
        "summary": "Get judge scores",
        "description": "Retrieves the scores submitted by the authenticated judge. Strictly blocks cross-judge inspection.",
        "responses": {
          "200": {
            "description": "Judge's own scores"
          },
          "403": {
            "description": "Access to peer scores forbidden"
          }
        }
      }
    },
    "/api/organizer/judging/export.csv": {
      "get": {
        "summary": "Export judging results CSV",
        "description": "Organizer-only CSV export of standings, raw scores, or progress.",
        "responses": {
          "200": {
            "description": "CSV file download"
          }
        }
      }
    },
    "/api/judging/pairwise/compare": {
      "post": {
        "summary": "Submit pairwise comparison",
        "description": "Records judge preference between Project A and Project B for Bradley-Terry model estimation.",
        "responses": {
          "201": {
            "description": "Comparison recorded"
          }
        }
      }
    },
    "/api/judging/pairwise/standings": {
      "get": {
        "summary": "Get Bradley-Terry pairwise standings",
        "description": "Computes maximum likelihood latent strength parameters and rankings via Hunter's MM algorithm.",
        "responses": {
          "200": {
            "description": "Converged rankings and latent strengths"
          }
        }
      }
    },
    "/api/community/vote": {
      "post": {
        "summary": "Cast community vote",
        "description": "Community voting with rate-limiting and duplicate prevention.",
        "responses": {
          "201": {
            "description": "Vote recorded"
          }
        }
      }
    },
    "/api/certificates/verify/{id}": {
      "get": {
        "summary": "Verify certificate",
        "description": "Publicly verifies a digital participation or judging certificate using HMAC-SHA256.",
        "responses": {
          "200": {
            "description": "Verification report with cryptographic validity"
          }
        }
      }
    }
  }
}
