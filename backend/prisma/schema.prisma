datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  passwordHash     String
  name             String
  isGlobalAdmin    Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organizedEvents  Event[]           @relation("OrganizerEvents")
  eventMemberships EventMember[]
  judgeProfiles    Judge[]
  ledTeams         Team[]            @relation("TeamLeader")
  teamMemberships  TeamMember[]
  auditLogs        AuditLog[]
}

model Event {
  id                     Int      @id @default(autoincrement())
  title                  String
  tagline                String?
  description            String
  rules                  String?
  minTeamSize            Int      @default(1)
  maxTeamSize            Int      @default(4)
  startDate              DateTime
  deadline               DateTime
  judgingDeadline        DateTime?
  status                 String   @default("ACTIVE")
  isLeaderboardPublished     Boolean  @default(false)
  isCommunityVotingOpen      Boolean  @default(true)
  isCommunityResultsRevealed Boolean  @default(false)
  communityVotingMode        String   @default("EMAIL") // "OPEN", "EMAIL", "AUTHENTICATED"

  organizerId Int
  organizer   User @relation("OrganizerEvents", fields: [organizerId], references: [id], onDelete: Cascade)

  members             EventMember[]
  criteria            Criterion[]
  tracks              Track[]
  prizes              Prize[]
  questions           EventQuestion[]
  teams               Team[]
  submissions         Submission[]
  judges              Judge[]
  normalizedScores    NormalizedScore[]
  communityVotes      CommunityVote[]
  webhooks            Webhook[]
  pairwiseComparisons PairwiseComparison[]
  certificates        Certificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Prize {
  id          Int      @id @default(autoincrement())
  eventId     Int
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String?
  value       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EventQuestion {
  id          Int      @id @default(autoincrement())
  eventId     Int
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  question    String
  isRequired  Boolean  @default(false)
  order       Int      @default(0)

  answers     SubmissionAnswer[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Track {
  id          Int      @id @default(autoincrement())
  eventId     Int
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String?

  judgeTracks JudgeTrack[]
  submissions Submission[]
  assignments JudgeAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventMember {
  eventId Int
  userId  Int
  role    String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([eventId, userId])
  @@index([userId])
  @@index([eventId, role])
}

model Judge {
  id      Int @id @default(autoincrement())
  eventId Int
  userId  Int

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  status String @default("INVITED")

  tracks              JudgeTrack[]
  assignments         JudgeAssignment[]
  scores              Score[]              @relation("JudgeScores")
  normalizedScores    NormalizedScore[]
  pairwiseComparisons PairwiseComparison[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
}

model JudgeTrack {
  judgeId Int
  trackId Int

  judge Judge @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([judgeId, trackId])
}

model JudgeAssignment {
  id           Int @id @default(autoincrement())
  judgeId      Int
  submissionId Int

  judge      Judge      @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  trackId Int?
  track   Track?  @relation(fields: [trackId], references: [id], onDelete: SetNull)
  batch   String?

  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([judgeId, submissionId])
  @@index([submissionId])
}

model Criterion {
  id          Int      @id @default(autoincrement())
  eventId     Int
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String?
  maxScore    Int      @default(10)
  weight      Float    @default(1.0)
  scores      Score[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id         Int      @id @default(autoincrement())
  eventId    Int
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name       String
  inviteCode String   @unique

  leaderId Int
  leader   User @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Cascade)

  isRegistered Boolean @default(false)

  members    TeamMember[]
  submission Submission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, name])
}

model TeamMember {
  id       Int      @id @default(autoincrement())
  teamId   Int
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   Int
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model Submission {
  id          Int      @id @default(autoincrement())
  teamId      Int      @unique
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  eventId     Int
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  status      String   @default("DRAFT") // "DRAFT", "SUBMITTED"

  title       String
  tagline     String?
  description String
  thumbnailUrl String?
  imageGallery String? // Stored as stringified JSON array
  repoUrl     String?
  demoUrl     String?
  videoUrl    String?
  techStack   String?

  trackId     Int?
  track       Track?   @relation(fields: [trackId], references: [id])

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scores              Score[]
  assignments         JudgeAssignment[]
  answers             SubmissionAnswer[]
  normalizedScores    NormalizedScore[]
  comments            Comment[]
  communityVotes      CommunityVote[]
  pairwiseWins        PairwiseComparison[] @relation("PairwiseWinner")
  pairwiseLosses      PairwiseComparison[] @relation("PairwiseLoser")
}

model SubmissionAnswer {
  id           Int           @id @default(autoincrement())
  submissionId Int
  submission   Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   Int
  question     EventQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer       String

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([submissionId, questionId])
}

model Score {
  id           Int @id @default(autoincrement())
  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judgeId      Int
  judge        Judge @relation("JudgeScores", fields: [judgeId], references: [id], onDelete: Cascade)
  criterionId  Int
  criterion    Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  score        Float
  feedback     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submissionId, judgeId, criterionId])
}

model NormalizedScore {
  id              Int        @id @default(autoincrement())
  eventId         Int
  event           Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submissionId    Int
  submission      Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judgeId         Int?
  judge           Judge?     @relation(fields: [judgeId], references: [id], onDelete: SetNull)
  rawScore        Float
  normalizedScore Float
  metadata        String?    // JSON string storing details (mean, stddev, zScore, etc.)

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([eventId])
  @@index([submissionId])
  @@index([judgeId])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorId     Int?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  targetType  String?
  targetId    String?
  metadata    String?
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([timestamp])
}

model CommunityVote {
  id           Int        @id @default(autoincrement())
  eventId      Int
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  voterEmail   String?
  voterIp      String?
  credits      Int        @default(1)
  createdAt    DateTime   @default(now())

  @@unique([submissionId, voterEmail])
  @@index([eventId])
  @@index([voterEmail])
}

model Comment {
  id           Int        @id @default(autoincrement())
  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  authorName   String
  authorEmail  String
  content      String
  createdAt    DateTime   @default(now())

  @@index([submissionId])
}

model Webhook {
  id        Int      @id @default(autoincrement())
  eventId   Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url       String
  secret    String
  events    String   // Comma-separated list: "submission.created,score.submitted,judging.finalized"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

model PairwiseComparison {
  id        Int        @id @default(autoincrement())
  eventId   Int
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judgeId   Int?
  judge     Judge?     @relation(fields: [judgeId], references: [id], onDelete: SetNull)
  winnerId  Int
  loserId   Int
  winner    Submission @relation("PairwiseWinner", fields: [winnerId], references: [id], onDelete: Cascade)
  loser     Submission @relation("PairwiseLoser", fields: [loserId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@index([eventId])
  @@index([winnerId, loserId])
}

model Certificate {
  id             String   @id // e.g. "cert-uuid" or hash
  eventId        Int
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipientName  String
  recipientEmail String
  role           String   // "JUDGE", "PARTICIPANT", "WINNER", "ORGANIZER"
  signature      String   // HMAC-SHA256 digital signature
  metadata       String?  // JSON string storing details (hours, track, score, etc.)
  issuedAt       DateTime @default(now())

  @@index([eventId])
  @@index([recipientEmail])
}

