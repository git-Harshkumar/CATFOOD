datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  passwordHash     String
  name             String
  isGlobalAdmin    Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organizedEvents  Event[]           @relation("OrganizerEvents")
  eventMemberships EventMember[]
  judgeProfiles    Judge[]
  ledTeams         Team[]            @relation("TeamLeader")
  teamMemberships  TeamMember[]
  auditLogs        AuditLog[]
  comments         Comment[]
  communityVotes   CommunityVote[]
  voterBalances    VoterBalance[]
}

model Event {
  id                     Int      @id @default(autoincrement())
  title                  String
  tagline                String?
  description            String
  rules                  String?
  minTeamSize            Int      @default(1)
  maxTeamSize            Int      @default(4)
  startDate              DateTime
  deadline               DateTime
  judgingDeadline        DateTime?
  status                 String   @default("ACTIVE")
  isLeaderboardPublished     Boolean  @default(false)
  isCommunityVotingOpen      Boolean  @default(true)
  isCommunityResultsRevealed Boolean  @default(false)
  communityVotingMode        String   @default("EMAIL") // "OPEN", "EMAIL", "AUTHENTICATED"

  organizerId Int
  organizer   User @relation("OrganizerEvents", fields: [organizerId], references: [id], onDelete: Cascade)

  members             EventMember[]
  criteria            Criterion[]
  tracks              Track[]
  prizes              Prize[]
  questions           EventQuestion[]
  teams               Team[]
  submissions         Submission[]
  judges              Judge[]
  normalizedScores    NormalizedScore[]
  communityVotes      CommunityVote[]
  voterBalances       VoterBalance[]
  emailVerifications  EmailVerification[]
  auditLogs           AuditLog[]
  webhooks            Webhook[]
  pairwiseComparisons PairwiseComparison[]
  certificates        Certificate[]
  webhookDeliveries   WebhookDelivery[]
  embedConfig         EmbedConfig?
  importJobs          ImportJob[]
  exportJobs          ExportJob[]
  communityVoteCreditBudget Int @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Prize {
  id          Int      @id @default(autoincrement())
  eventId     Int
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String?
  value       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EventQuestion {
  id          Int      @id @default(autoincrement())
  eventId     Int
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  question    String
  isRequired  Boolean  @default(false)
  order       Int      @default(0)

  answers     SubmissionAnswer[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Track {
  id          Int      @id @default(autoincrement())
  eventId     Int
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String?

  judgeTracks JudgeTrack[]
  submissions Submission[]
  assignments JudgeAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventMember {
  eventId Int
  userId  Int
  role    String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([eventId, userId])
  @@index([userId])
  @@index([eventId, role])
}

model Judge {
  id      Int @id @default(autoincrement())
  eventId Int
  userId  Int

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  status String @default("INVITED")

  tracks              JudgeTrack[]
  assignments         JudgeAssignment[]
  scores              Score[]              @relation("JudgeScores")
  normalizedScores    NormalizedScore[]
  pairwiseComparisons PairwiseComparison[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
}

model JudgeTrack {
  judgeId Int
  trackId Int

  judge Judge @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([judgeId, trackId])
}

model JudgeAssignment {
  id           Int @id @default(autoincrement())
  judgeId      Int
  submissionId Int

  judge      Judge      @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  trackId Int?
  track   Track?  @relation(fields: [trackId], references: [id], onDelete: SetNull)
  batch   String?

  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([judgeId, submissionId])
  @@index([submissionId])
}

model Criterion {
  id          Int      @id @default(autoincrement())
  eventId     Int
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String?
  maxScore    Int      @default(10)
  weight      Float    @default(1.0)
  scores      Score[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id         Int      @id @default(autoincrement())
  eventId    Int
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name       String
  inviteCode String   @unique

  leaderId Int
  leader   User @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Cascade)

  isRegistered Boolean @default(false)

  members    TeamMember[]
  submission Submission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, name])
}

model TeamMember {
  id       Int      @id @default(autoincrement())
  teamId   Int
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   Int
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model Submission {
  id          Int      @id @default(autoincrement())
  teamId      Int      @unique
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  eventId     Int
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  status      String   @default("DRAFT") // "DRAFT", "SUBMITTED"
  fixtureId   String?  @unique

  title       String
  tagline     String?
  description String
  thumbnailUrl String?
  imageGallery String? // Stored as stringified JSON array
  repoUrl     String?
  demoUrl     String?
  videoUrl    String?
  techStack   String?

  trackId     Int?
  track       Track?   @relation(fields: [trackId], references: [id])

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scores              Score[]
  assignments         JudgeAssignment[]
  answers             SubmissionAnswer[]
  normalizedScores    NormalizedScore[]
  comments            Comment[]
  communityVotes      CommunityVote[]
  pairwiseWins        PairwiseComparison[] @relation("PairwiseWinner")
  pairwiseLosses      PairwiseComparison[] @relation("PairwiseLoser")
}

model SubmissionAnswer {
  id           Int           @id @default(autoincrement())
  submissionId Int
  submission   Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   Int
  question     EventQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer       String

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([submissionId, questionId])
}

model Score {
  id           Int @id @default(autoincrement())
  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judgeId      Int
  judge        Judge @relation("JudgeScores", fields: [judgeId], references: [id], onDelete: Cascade)
  criterionId  Int
  criterion    Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  score        Float
  feedback     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submissionId, judgeId, criterionId])
}

model NormalizedScore {
  id              Int        @id @default(autoincrement())
  eventId         Int
  event           Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submissionId    Int
  submission      Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judgeId         Int?
  judge           Judge?     @relation(fields: [judgeId], references: [id], onDelete: SetNull)
  rawScore        Float
  normalizedScore Float
  metadata        String?    // JSON string storing details (mean, stddev, zScore, etc.)

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([eventId])
  @@index([submissionId])
  @@index([judgeId])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  eventId     Int?
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actorId     Int?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  targetType  String?
  targetId    String?
  metadata    String?
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([eventId])
  @@index([eventId, action])
  @@index([actorId])
  @@index([action])
  @@index([timestamp])
}

model CommunityVote {
  id              Int         @id @default(autoincrement())
  eventId         Int
  event           Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submissionId    Int
  submission      Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  voterIdentifier String      // Non-null canonical identity: e.g. "user:42", "email:foo@bar.com", or "token:<uuid>"
  voterUserId     Int?
  voterUser       User?       @relation(fields: [voterUserId], references: [id], onDelete: SetNull)
  voterEmail      String?
  voterIp         String?
  credits         Int         @default(1)
  createdAt       DateTime    @default(now())

  @@unique([submissionId, voterIdentifier])
  @@index([eventId])
  @@index([voterIdentifier])
  @@index([submissionId])
}

model VoterBalance {
  id               Int      @id @default(autoincrement())
  eventId          Int
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  voterIdentifier  String
  voterUserId      Int?
  voterUser        User?    @relation(fields: [voterUserId], references: [id], onDelete: SetNull)
  totalCredits     Int      @default(100)
  usedCredits      Int      @default(0)
  remainingCredits Int      @default(100)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([eventId, voterIdentifier])
  @@index([eventId])
  @@index([voterIdentifier])
}

model EmailVerification {
  id          Int       @id @default(autoincrement())
  eventId     Int
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime
  isVerified  Boolean   @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([eventId, email])
  @@index([tokenHash])
}

model Comment {
  id           Int        @id @default(autoincrement())
  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  authorId     Int?
  author       User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName   String
  authorEmail  String
  content      String
  isDeleted    Boolean    @default(false)
  deletedAt    DateTime?
  deletedBy    Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt

  @@index([submissionId])
  @@index([authorId])
}

model Webhook {
  id           Int               @id @default(autoincrement())
  eventId      Int
  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url          String
  secret       String
  events       String            // Comma-separated list: "submission.created,score.submitted,judging.finalized"
  isActive     Boolean           @default(true)
  failureCount Int               @default(0)
  deliveries   WebhookDelivery[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([eventId])
}

model WebhookDelivery {
  id             String    @id @default(uuid())
  webhookId      Int
  webhook        Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  eventId        Int
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventType      String
  payload        String
  responseStatus Int?
  responseBody   String?
  durationMs     Int?
  status         String    @default("PENDING") // PENDING, SUCCESS, FAILED
  attempts       Int       @default(0)
  nextRetryAt    DateTime?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([webhookId])
  @@index([eventId])
  @@index([status, nextRetryAt])
}

model PairwiseComparison {
  id        Int        @id @default(autoincrement())
  eventId   Int
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judgeId   Int?
  judge     Judge?     @relation(fields: [judgeId], references: [id], onDelete: SetNull)
  winnerId  Int
  loserId   Int
  winner    Submission @relation("PairwiseWinner", fields: [winnerId], references: [id], onDelete: Cascade)
  loser     Submission @relation("PairwiseLoser", fields: [loserId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@index([eventId])
  @@index([winnerId, loserId])
}

model Certificate {
  id               String    @id // e.g. "cert-uuid" or hash
  eventId          Int
  event            Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipientName    String
  recipientEmail   String
  role             String    // "JUDGE", "PARTICIPANT", "WINNER", "ORGANIZER"
  signature        String    // Ed25519 or HMAC digital signature
  metadata         String?   // JSON string storing details (hours, track, score, etc.)
  status           String    @default("ACTIVE") // ACTIVE, REVOKED
  revokedAt        DateTime?
  revokedBy        Int?
  revocationReason String?
  keyId            String?
  algorithm        String    @default("Ed25519")
  artifactPath     String?
  issuedAt         DateTime  @default(now())

  @@index([eventId])
  @@index([recipientEmail])
  @@index([status])
}

model SigningKey {
  id          Int       @id @default(autoincrement())
  keyId       String    @unique
  algorithm   String    @default("Ed25519")
  publicKey   String
  status      String    @default("ACTIVE") // ACTIVE, RETIRED
  createdAt   DateTime  @default(now())
  activatedAt DateTime  @default(now())
  retiredAt   DateTime?
}

model EmbedConfig {
  id          Int      @id @default(autoincrement())
  eventId     Int      @unique
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  theme       String   @default("dark") // dark, light, auto
  layout      String   @default("grid")
  pageSize    Int      @default(24)
  showTracks  Boolean  @default(true)
  showTeam    Boolean  @default(true)
  showRepo    Boolean  @default(true)
  showDemo    Boolean  @default(true)
  customCss   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ImportJob {
  id             String    @id @default(uuid())
  eventId        Int
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type           String    // PROJECTS, JUDGES, EVENT_BUNDLE
  status         String    @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, FAILED, CANCELLED
  progress       Int       @default(0)
  totalItems     Int       @default(0)
  processedItems Int       @default(0)
  errorCount     Int       @default(0)
  errorLog       String?   // JSON array of row errors
  artifactPath   String?
  createdBy      Int?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([eventId])
  @@index([status])
}

model ExportJob {
  id             String    @id @default(uuid())
  eventId        Int
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type           String    // EVENT_BUNDLE, JUDGING_CSV
  status         String    @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, FAILED
  artifactPath   String?
  createdBy      Int?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([eventId])
  @@index([status])
}


