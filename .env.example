# ==============================================================================
# DOGFOOD / CATFOOD Hackathon Platform - Environment Configuration Example
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Runtime Configuration (Backend Container / Host)
# ------------------------------------------------------------------------------
# The port the Express API server listens on
PORT=8080

# Environment mode ('development' or 'production')
NODE_ENV=production

# SQLite database file URL for Prisma
# Inside Docker Compose, this points to the persistent volume mount:
DATABASE_URL=file:/app/data/dev.db

# JWT Secret for authenticating users (Participants, Judges, Organizers, Admins)
# In production, replace with a long, cryptographically random secret
JWT_SECRET=super-secure-hackathon-platform-secret-key-2026

# Token expiration duration
JWT_EXPIRES_IN=30d

# Allowed frontend origin for CORS requests
FRONTEND_URL=http://localhost:5173

# HMAC signing secret for verifiable certificates
CERT_SECRET=dogfood-certificate-signing-key-2026

# Set to 'true' to force re-seeding fixtures even if database already contains records
FORCE_SEED=false

# ------------------------------------------------------------------------------
# Frontend Configuration (Frontend Container / Vite Proxy)
# ------------------------------------------------------------------------------
# Backend target URL used by the Vite proxy inside Docker to forward /api requests.
# Inside Docker Compose network, use the internal service name: http://backend:8080
# For local host development without Docker, use: http://localhost:8080
BACKEND_URL=http://backend:8080

# Optional: Override the frontend API base path (defaults to '/api' for same-origin proxy)
# VITE_API_BASE_URL=/api
